# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Conexión Prisma para backend (en runtime/Docker toma POSTGRES_* automáticamente cuando POSTGRES_HOST está definido)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# App & Server
PORT=5000
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# WhatsApp Business Cloud API (Oficial de Meta)
META_API_VERSION="v21.0"
META_GRAPH_URL="https://graph.facebook.com"
META_WEBHOOK_VERIFY_TOKEN="meta_webhook_verify_token_whatsapp_crm"

# Credenciales por defecto para pruebas de desarrollo (Opcional si cada tenant registra las suyas)
META_DEFAULT_PHONE_NUMBER_ID=""
META_DEFAULT_ACCESS_TOKEN=""

# AI Provider (Google Gemini)
AI_PROVIDER="gemini"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_API_KEY="your-gemini-api-key"
